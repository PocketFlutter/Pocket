{
  "$schema": "https://pocketjs.dev/schema/pocket-guest-manifest.json",
  "protocolVersion": 1,
  "capabilities": {
    "requires": [
      "text.glyphs.baked",
      "ui.compositor-surfaces"
    ],
    "optional": [
      "clipboard.readText",
      "clipboard.hasText",
      "clipboard.writeText",
      "files.pickOpen",
      "files.readChunk",
      "files.release",
      "system.runtime.configure",
      "system.runtime.create",
      "system.runtime.destroy",
      "system.runtime.post",
      "system.runtime.respond",
      "studio.artifacts.inspect",
      "studio.artifacts.list",
      "studio.assets.preview",
      "studio.assets.upload.begin",
      "studio.build.cancel",
      "studio.build.events",
      "studio.build.start",
      "studio.build.status",
      "studio.cos.check",
      "studio.cos.get",
      "studio.cos.publish",
      "studio.cos.set",
      "studio.ecosystem.catalog",
      "studio.ecosystem.get",
      "studio.ecosystem.set",
      "studio.fs.delete",
      "studio.fs.mkdir",
      "studio.fs.read",
      "studio.fs.readChunk",
      "studio.fs.rename",
      "studio.fs.rmdir",
      "studio.fs.stat",
      "studio.fs.tree",
      "studio.fs.upload.abort",
      "studio.fs.upload.begin",
      "studio.fs.upload.chunk",
      "studio.fs.upload.commit",
      "studio.fs.watch",
      "studio.fs.write",
      "studio.logs.diagnostics",
      "studio.logs.tail",
      "studio.preview.deploy",
      "studio.preview.deployCancel",
      "studio.preview.deployStatus",
      "studio.preview.devices",
      "studio.preview.publish",
      "studio.project.create",
      "studio.project.list",
      "studio.project.open",
      "studio.project.openLocal",
      "studio.project.resources.get",
      "studio.project.resources.preview",
      "studio.project.resources.set",
      "studio.project.settings.get",
      "studio.project.settings.set",
      "studio.publish.history",
      "studio.publish.offline",
      "studio.publish.plan",
      "studio.publish.publish",
      "studio.service.health",
